# ─────────────────────────────────────────────────────────────
# Camp Mate — environment configuration
# Copy to `.env.local` for local dev. Set the same vars in Vercel.
# The app BOOTS with nothing set (demo mode). Features unlock as
# you add credentials.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for auth redirects + metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (auth + file storage) ───────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never exposed to the browser. Used for storage writes.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for uploaded documents (create it in Supabase → Storage)
SUPABASE_STORAGE_BUCKET=documents

# ── Database (Supabase Postgres) ─────────────────────────────
# Project Settings → Database → Connection string (URI).
# Use the pooled connection for DATABASE_URL, direct for migrations.
DATABASE_URL=
DIRECT_URL=

# ── AI provider (OpenAI-compatible) ──────────────────────────
# Works with OpenAI, OpenRouter, Groq, Together, local servers, etc.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_MODEL=text-embedding-3-small
